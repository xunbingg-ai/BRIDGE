# ============================================================================
# Dependency & build isolation — DO NOT COMMIT these.
# pip/npm deps live locally (backend/.venv, frontend/node_modules) and are
# ignored so they never pollute the global env or leak into git.
# ============================================================================

# ---------- Node / npm / pnpm ----------
node_modules/
.pnpm-store/
.npm/
*.tgz
pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# ---------- Nuxt / Vite build & dev outputs ----------
.nuxt/
.output/
.nitro/
.data/
.cache/
dist/
.generates/

# ---------- Playwright e2e artifacts ----------
test-results/
playwright-report/
blob-report/
*.last-run.json

# ---------- Python / pip / venv ----------
.venv/
venv/
env/
*.egg-info/
*.egg
build/
.eggs/

# Python caches & coverage
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.so
*.whl
pip-wheel-metadata/

# ---------- Backend runtime data ----------
backend/osce.db

# ---------- Logs ----------
logs/
*.log

# ---------- Local env files (secrets / config) ----------
.env
.env.*
*.local
!.env.example

# ---------- Editors / OS ----------
.DS_Store
.fleet
.idea
.vscode/
*.swp
*~
Thumbs.db

# ---------- Agent skills/config (local, not version-tracked) ----------
.agents/

